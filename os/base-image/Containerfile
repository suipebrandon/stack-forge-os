# Stack Forge OS MVP-1 base image — bootc pattern (RUN ON LINUX ONLY)
# Fedora 42 Bootc (supported; Kinoite :41 tag is EOL/unauthorized as of Oct 2026).
# KDE Plasma added on top — do not build DE/kernel from source (SRS AR-04).
FROM quay.io/fedora/fedora-bootc:42

# KDE Plasma desktop + base tools (keep layer small for MVP-1)
RUN dnf install -y \
      plasma-desktop sddm \
      greenboot greenboot-default-health-checks \
      flatpak NetworkManager-wifi bluez pipewire wireplumber \
      && dnf clean all \
      && systemctl enable greenboot-healthcheck greenboot-task-runner NetworkManager bluetooth sddm \
      && bootc container lint --no-truncate || true

LABEL org.stackforge.os="stack-forge-os" \
      org.stackforge.version="mvp1" \
      org.opencontainers.image.title="Stack Forge OS MVP-1"

